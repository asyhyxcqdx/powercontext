# --- seekdb ---------------------------------------------------------------
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=change-me
SEEKDB_DATABASE=litmemory
SEEKDB_TENANT=sys
SEEKDB_COLLECTION=litmemory_notes

# --- PowerContext ---------------------------------------------------------
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_SCOPE=project:litmemory:demo
POWERCONTEXT_TIMEOUT=20

# --- embeddings -----------------------------------------------------------
# 512-dim Chinese embedding; falls back to deterministic hashing if the
# model cannot be downloaded (retrieval keeps working, quality drops).
LITMEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- app ------------------------------------------------------------------
LITMEMORY_HOST=0.0.0.0
LITMEMORY_PORT=8765
LITMEMORY_AUTOSEED=1
