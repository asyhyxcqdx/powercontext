# This file contains placeholders only. Copy to .env and set your own values.
# The PowerContext server and SDD CLI run on the same Ubuntu Linux server.
MINIMAX_API_KEY=REPLACE_WITH_YOUR_MINIMAX_API_KEY
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_API_URL=https://api.minimax.io/v1/text/chatcompletion_v2
POWERCONTEXT_URL=http://127.0.0.1:18080
# Set POWERCONTEXT_TOKEN only when the server requires bearer authentication.
POWERCONTEXT_TOKEN=
# No OB_ variables: use embedded seekdb. To use remote seekdb/OceanBase set:
# OB_HOST=127.0.0.1
# OB_PORT=2881
# OB_USER=root@test
# OB_PASSWORD=REPLACE_WITH_PASSWORD
# OB_DATABASE=test
